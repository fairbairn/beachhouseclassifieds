      {
        "author": "Ashley M.",
        "date": "2022-07-10T22:07:29Z",
        "id": "62cb4da470c3c778abbf997c",
        "label": "Excellent",
        "locale": "en_US",
        "rating": 10,
        "responses": [
          {
            "date": "Sep 19, 2023",
            "id": "0f567e21-76e4-47a6-a873-0a077401a6e7",
            "locale": "en_us",
            "response": "We are delighted this WaterColor home was the right fit for your family, and everyone had a great July 4th. We hope you revisit 30A soon; thank you for being our guest!",
            "user": "VrboOwner"
          }
        ],
        "text": "The property was exactly as depicted. We had 15 adults and older teens and enjoyed our stay immensely. There was plenty of space and nice outdoor patios. The location was about a 7 minute golf cart ride to the beach but very close to Publix and the liquor store. The teens were able to ride their bikes to the beach, Watercolor beach club, and seaside. We had a few issues with smoke detectors but Blue 360 sent maintenance out and it was immediately resolved. When we called Blue 360 for additional information, they were responsive and helpful.",
        "themes": [
          "Liked: Cleanliness, check-in, communication, location, listing accuracy"
        ],
        "title": "Great July 4th Vacation",
        "verified": true
      }

        "responses": [
          {
            "date": "Mar 31, 2020",
            "id": "a93c5f29-2e2a-42d2-bf44-62d0be885c78",
            "locale": "en_us",
            "response": "Katie, we are so happy to hear that you enjoyed your stay in WaterColor! We completely agree that this beautiful home offers plenty of space and the views are absolutely amazing. Thank you for staying with 360 Blue and we look forward to hosting you all again soon!",
            "user": "VrboOwner"
          }
        ],
        "text": "We always love going to Watercolor. Our daughter got married February 22 and we love staying at this house! It’s beautifully decorated, spacious with plenty of room for everyone. The views are amazing!!! We had a \ngreat time. And we will definitely be back!",
        "title": "February 2020 Stay"
      },
      {

      },
      {
        "author": "Sally S.",
        "date": "2019-09-04T13:22:00Z",
        "id": "5e8395776c6b4f0001d28561",
        "label": "Excellent",
        "locale": "en_US",
        "rating": 10,
        "responses": [
          {
            "date": "Mar 31, 2020",
            "id": "dd0a0816-0f8c-4e82-9b43-650b84e5a7a5",
            "locale": "en_us",
            "response": "We are so thrilled the whole family was able to enjoy your husband's birthday in Watercolor! We agree- the home is truly beautiful and having the newly renovated Camp Pool is so wonderful! Thank you so much for choosing to stay with 360 Blue and we hope to see you back at the beach again soon!",
            "user": "VrboOwner"
          }
        ],
        "text": "We celebrated my husband’s 70 th Happy Birthday on Red Cedar Way! Our 4 children joined us with their spouses and 8 GRANDS! The house was absolutely beautiful and perfect for all of us, with enough space for everyone. We enjoyed biking, swimming at the Camp Watercolor pool, grilling out, and watching the Auburn football game! We appreciated the wonderful service of the 360 Blue team. We have rented beautiful houses from them as our tradition is to come to Watercolor every Labor Day weekend.",
        "title": "August 2019 Stay"
      }

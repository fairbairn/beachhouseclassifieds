        ],
        "title": "Incredible home for families",
        "verified": true
      },
      {
        "author": "Jordan P.",
        "date": "2025-08-13T18:48:33Z",
        "id": "689cec4add9a7673d4e32ede",
        "label": "Good",
        "locale": "en_US",
        "rating": 8,
        "text": "We’ve stayed at multiple houses in Watercolor before and this was the only one that didn’t have a vacuum, cleaning supplies, blankets, laundry soap, or dishwasher soap. Everything was at minimum. The stove didn’t work one day, and they came the next day to fix it. Great size for two families and close to camp watercolor!",
        "themes": [
          "Liked: Cleanliness, check-in, communication, location, listing accuracy"
        ],

# These will be automatically created by Neon Launchpad (https://neon.new).
# For local Docker Postgres, you can use:
# DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
DATABASE_URL=

# App/provider mode during migration.
# sqlite (default): current stable app data path.
# postgres: Better Auth uses Postgres; SQLite project/ratecard seed/setup is skipped.
DATABASE_PROVIDER=sqlite

# Better Auth
# Required for deployed/non-localhost environments.
BETTER_AUTH_SECRET=
# Optional override for auth URL (defaults to http://localhost:3000).
BETTER_AUTH_BASE_URL=

# Optional for interactive Google Maps JS map (enables normal mouse-wheel zoom on discover map panel).
VITE_GOOGLE_MAPS_API_KEY=

# Local-only auth users file (APP_ENV_PROFILE=local only):
# .users.local

# Apify (optional for scraper routines)
APIFY_API_TOKEN=
APIFY_PROXY_GROUPS=RESIDENTIAL
APIFY_PROXY_COUNTRY=US

# Discover search backend selection
# postgres (default) | meilisearch
DISCOVER_SEARCH_BACKEND=postgres

# Meilisearch (required when DISCOVER_SEARCH_BACKEND=meilisearch)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_DISCOVER_INDEX=discover_listings_v1

{
  "adapter_key": "royaldestinations",
  "platform_family": "track_bluetent",
  "currency": "USD",
  "rates_conformity": {
    "status": "in_progress",
    "ready": false,
    "last_validated_at": "2026-03-30T00:00:00.000Z",
    "blocking_gaps": [
      "deterministic request shaping + quote parser",
      "requires at least 3 pricing assumption samples",
      "listing pricing cache not yet generated"
    ]
  },
  "capabilities": {
    "listing_daily_rates": {
      "supported": false,
      "source": "normalized_rates.days"
    },
    "ad_hoc_quote": {
      "supported": true,
      "transport": "http_post_form",
      "response_format": "html_fragment"
    },
    "checkout_handoff": {
      "supported": true,
      "transport": "url",
      "requires_quote_context": true
    }
  },
  "quote_signature": {
    "method": "POST",
    "url": "https://www.royaldestinations.com/rescms/ajax/item/pricing/simple",
    "content_type": "application/x-www-form-urlencoded",
    "required_params": ["begin", "end", "eid"],
    "date_param_format": "MM/DD/YYYY",
    "response_extractors": {
      "rent_total": "pending_probe",
      "taxes_total": "pending_probe",
      "all_in_total": "pending_probe",
      "checkout_handoff_url": "pending_probe"
    },
    "probe_evidence": {
      "report_path": "",
      "source_listing_id": "",
      "sample_window": {
        "check_in_date": "",
        "check_out_date": "",
        "nights": 0
      }
    }
  },
  "handoff_signature": {
    "url_template": "https://www.royaldestinations.com/booking-checkout?eid={eid}&begin={checkin}&end={checkout}",
    "required_params": ["eid", "begin", "end"],
    "date_param_format": "MM/DD/YYYY",
    "source": "pending_probe"
  },
  "estimation_policy": {
    "nightly_base_strategy": "quote_window_average",
    "fees_taxes_strategy": "adapter_assumptions_multiplier",
    "fallback_order": [
      "listing_daily_rates",
      "ad_hoc_quote_window_average",
      "adapter_assumptions"
    ]
  },
  "assumptions_policy": {
    "min_samples_for_ready": 3,
    "max_sample_age_days": 45,
    "refresh_cadence": "monthly"
  }
}

  },
  "quote_signature": {
    "method": "GET",
    "url": "https://www.30aluxuryvacations.com/rcapi/item/avail/search",
    "required_params": [
      "rcav[begin]",
      "rcav[end]",
      "rcav[adult]",
      "rcav[child]",
      "rcav[eid]",
      "rcav[flex]",
      "rcav[flex_type]"
    ],
    "date_param_format": "MM/DD/YYYY",
    "response_extractors": {
      "quoted_total": "prices[0].p",
      "currency": "prices[0].c",
      "checkout_handoff_url": "derived_template"
    },
    "probe_evidence": {
      "report_path": "",
      "source_listing_id": "seaside-vibes",
      "sample_window": {
        "check_in_date": "2026-11-07",
        "check_out_date": "2026-11-14",
        "nights": 7
      }
    }
  },
  "handoff_signature": {
    "url_template": "https://www.30aluxuryvacations.com/rescms/item/{eid}/buy?rcav[begin]={checkin}&rcav[end]={checkout}&rcav[adult]={adults}&rcav[child]={children}&rcav[eid]={eid}&rcav[IDs][{type}][]={ids}&eid={eid}",
    "required_params": [
      "eid",
      "rcav[begin]",
      "rcav[end]",
      "rcav[adult]",
      "rcav[child]",
      "rcav[eid]",
      "rcav[IDs][type][]"
    ],
    "date_param_format": "MM/DD/YYYY",
    "source": "quote_runtime_template"
  },
  "estimation_policy": {
    "nightly_base_strategy": "quote_window_average",
    "fees_taxes_strategy": "adapter_assumptions_multiplier",
    "fallback_order": [
      "listing_daily_rates",
      "ad_hoc_quote_window_average",
      "adapter_assumptions"
    ]
  },
  "assumptions_policy": {
    "min_samples_for_ready": 3,
    "max_sample_age_days": 45,
    "refresh_cadence": "monthly"
  }

FROM node:22-bookworm-slim AS deps

WORKDIR /app

COPY src/workers/fly/package.worker.json ./package.json
RUN npm install --no-audit --no-fund

FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY src/workers/fly/package.worker.json ./package.json
COPY tsconfig.worker.json ./
COPY src/workers/run-image-worker.ts ./src/workers/run-image-worker.ts
COPY src/workers/image-processing-task.ts ./src/workers/image-processing-task.ts
COPY src/workers/image-queue.ts ./src/workers/image-queue.ts
COPY src/core/tooling/env/environment-bundle.ts ./src/core/tooling/env/environment-bundle.ts
COPY src/core/tooling/env/profile-env.ts ./src/core/tooling/env/profile-env.ts

RUN npx tsc -p tsconfig.worker.json

FROM deps AS prod-deps

RUN npm prune --omit=dev && npm cache clean --force

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY src/workers/fly/package.worker.json ./package.json
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist-worker ./dist-worker

USER node

CMD ["node", "dist-worker/workers/run-image-worker.js"]

{
  "version": "2.0.0",
  "tasks": [
    {
      "id": "dev-tanstack-start",
      "label": "dev: tanstack start",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "group": "build"
    },
    {
      "id": "copilot-live-command",
      "label": "copilot: live command",
      "type": "shell",
      "command": "zsh",
      "args": [
        "-i",
        "-c",
        "bash src/core/tooling/terminal/capture-command.sh --tee --out .tmp/terminal-capture/latest.log -- bash .tmp/scripts/copilot-live-command.next.sh"
      ]
    }
  ]
}
